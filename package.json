{
  "name": "vs-chess",
  "displayName": "VS Chess",
  "description": "Play offline chess in the VS Code sidebar against Stockfish or a second player on the same computer.",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "chess",
    "stockfish",
    "board game",
    "offline",
    "local multiplayer"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#222c29",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:vsChess.game"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsChess",
          "title": "VS Chess",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "vsChess": [
        {
          "id": "vsChess.game",
          "name": "VS Chess",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test test/*.test.ts",
    "vsix": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.61.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.9"
    }
  }
}
